# Copia este fichero como .env y rellena solo lo que necesites.
# El fichero .env NUNCA se sube al repositorio.

# Proveedor del modelo de lenguaje: "ollama" (local, por defecto) o "api"
ESCANER_AI_PROVIDER=ollama
ESCANER_OLLAMA_URL=http://localhost:11434
ESCANER_OLLAMA_MODEL=

# Solo si ESCANER_AI_PROVIDER=api (nivel gratuito, límite de gasto a 0)
ESCANER_API_BASE_URL=
ESCANER_API_KEY=
ESCANER_API_MODEL=

# Clave opcional de la API de NVD (aumenta el límite de peticiones)
NVD_API_KEY=
